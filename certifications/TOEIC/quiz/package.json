{
  "name": "lapis-mock",
  "private": true,
  "version": "0.4.0",
  "description": "Lapis 模試（仮称）のアプリ版（Capacitor）。Web 版は quiz/ 直下をそのまま配る",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
